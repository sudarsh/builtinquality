---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArrowCard from '../components/ArrowCard.astro';
import { articlesNewestFirst } from '../data/articles';
import { person, LINKEDIN, GITHUB, EMAIL } from '../data/site';

const latest = articlesNewestFirst.slice(0, 3);

const projects = [
  { href: '/work#simulr', eyebrow: 'Founder & Product Architect', title: 'Simulr', desc: 'An agentic LLM testing loop: AI personas use a product in a real browser and explain each decision in plain English.' },
  { href: '/work#agent-pipeline', eyebrow: 'How I build Simulr', title: 'Agent-driven delivery pipeline', desc: 'Scenarios are frozen first. Separate dev and test agents work from them on separate branches.' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      ...person,
      jobTitle: 'QA Engineering Manager',
      description: 'QA Engineering Manager with 13+ years in quality engineering. Builds QA functions from scratch and works hands-on with AI testing.',
      address: { '@type': 'PostalAddress', addressLocality: 'Bengaluru', addressCountry: 'IN' },
    },
    {
      '@type': 'WebSite',
      name: 'Qualiteye',
      url: 'https://qualiteye.com/',
      author: { '@id': person['@id'] },
    },
  ],
};
---

<BaseLayout
  title="Sudarsh M. Sathianathan — QA Engineering Manager"
  description="QA Engineering Manager with 13+ years in quality engineering. Twice the first QA hire. Now working hands-on with Claude, Playwright and TypeScript on agent-driven testing and delivery."
  canonical="https://qualiteye.com/"
  ogUrl="https://qualiteye.com/"
  jsonLd={jsonLd}
>
  <div class="stack">
    <section class="animate">
      <h1 class="title">Hi, I'm Sudarsh.</h1>
      <div class="prose-plain" style="margin-top:1rem">
        <p>I'm a QA Engineering Manager in Bengaluru with 13+ years in quality engineering. I've been the first QA hire twice, and I build quality functions from scratch: strategy, hiring and release governance.</p>
        <p>On the technical side I build automation with Playwright, Cypress and Rest Assured, run it as CI/CD quality gates, and test LLM features.</p>
        <p>Since July 2025 I've been building <a class="link" href="/simulr">Simulr</a>, an AI testing product, hands-on with Claude, Playwright and TypeScript. I build it with an <a class="link" href="/work#agent-pipeline">agent-driven delivery pipeline</a> and write about what I learn on the <a class="link" href="/blog">blog</a>.</p>
        <p>Here's my <a class="link" href="/resume">resume</a> and my <a class="link" href="/work">work</a>.</p>
      </div>
    </section>

    <section class="animate">
      <div class="section-head">
        <h2>Latest posts</h2>
        <a class="link" href="/blog">See all posts</a>
      </div>
      <ul class="cards">
        {latest.map(a => <ArticleCard article={a} />)}
      </ul>
    </section>

    <section class="animate">
      <div class="section-head">
        <h2>Projects</h2>
        <a class="link" href="/work">See all work</a>
      </div>
      <ul class="cards">
        {projects.map(p => <ArrowCard href={p.href} title={p.title} desc={p.desc} />)}
      </ul>
    </section>

    <section class="animate" id="contact">
      <div class="section-head">
        <h2>Let's connect</h2>
      </div>
      <p class="serif">I'm open to QA Engineering Manager, Head of QA and AI quality engineering roles. Email <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a>, find me on <a class="link" href={LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a> or <a class="link" href={GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>, or send a message here.</p>
      <form class="form" action="https://formspree.io/f/mjgpgraq" method="POST">
        <div class="form-row">
          <label>Name<input type="text" name="name" required /></label>
          <label>Email<input type="email" name="email" required /></label>
        </div>
        <label>Subject<input type="text" name="subject" /></label>
        <label>Message<textarea name="message" required></textarea></label>
        <button class="button" type="submit">Send message</button>
      </form>
    </section>
  </div>
</BaseLayout>
