---
import BaseLayout from '../layouts/BaseLayout.astro';
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Simulr",
  "url": "https://simulr.ai",
  "description": "AI personas that test your app and your docs — so you don't have to wait for real users to tell you what's broken.",
  "applicationCategory": "DeveloperApplication",
  "author": { "@type": "Person", "name": "Sudarsh", "url": "https://qualiteye.com/#sudarsh" }
};
---
<BaseLayout
  title="Simulr — The Sims for your product"
  description="AI personas that test your app and your docs — so you don't have to wait for real users to tell you what's broken."
  canonical="https://qualiteye.com/simulr"
  ogTitle="Simulr — The Sims for your product"
  ogDescription="Run AI-powered user personas through your app before a single real user sees it."
  ogUrl="https://qualiteye.com/simulr"
  jsonLd={jsonLd}
  showNav={false}
>

<div id="simulr-page">

<!-- ─── NAV ─── -->
<header class="snav" id="snav" role="banner">
  <div class="snav-inner">
    <a href="/simulr" class="snav-logo" aria-label="Simulr home">
      <img src="/assets/simulr-logo-black.svg" alt="Simulr" class="snav-logoimg" />
    </a>
    <ul class="snav-links" role="list" aria-label="Main navigation">
      <li><a href="#problem">Problem</a></li>
      <li><a href="#how">How it works</a></li>
      <li><a href="#features">Features</a></li>
      <li><a href="#technology">Technology</a></li>
      <li><a href="#usecases">Use cases</a></li>
    </ul>
    <a href="#cta" class="sbtn sbtn-primary snav-cta">Get early access</a>
    <button class="snav-burger" id="snav-burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="snav-mobile" id="snav-mobile" hidden>
    <a href="#problem">Problem</a>
    <a href="#how">How it works</a>
    <a href="#features">Features</a>
    <a href="#technology">Technology</a>
    <a href="#usecases">Use cases</a>
    <a href="#cta" class="sbtn sbtn-primary">Get early access</a>
  </div>
</header>

<main id="main-content">

<!-- ─── HERO ─── -->
<section class="s-hero" id="hero" aria-label="Hero">
  <div class="sw">
    <div class="s-hero-layout">
      <div class="s-hero-text reveal">
        <div class="s-eyebrow">Pre-launch · Request early access</div>
        <h1 class="s-hero-h1">The Sims for<br><span class="s-hl">your product.</span></h1>
        <p class="s-hero-sub">Run AI-powered user personas through your app before a single real user sees it. They hesitate, misread, backtrack, and give up — exactly like real people. You get a plain-English report, not a test log.</p>
        <div class="s-hero-ctas">
          <a href="#cta" class="sbtn sbtn-primary">Request early access</a>
          <a href="#how" class="sbtn sbtn-secondary">See how it works</a>
        </div>
        <div class="s-hero-proof" aria-label="Key benefits">
          <span>No user recruiting</span>
          <span class="s-proof-dot" aria-hidden="true">·</span>
          <span>Results in minutes</span>
          <span class="s-proof-dot" aria-hidden="true">·</span>
          <span>Plain-English output</span>
        </div>
      </div>
      <div class="s-hero-panel reveal reveal-delay">
        <div class="s-simlog" aria-label="Live Sim Log example">
          <div class="s-simlog-bar">
            <div class="s-simlog-live">
              <span class="s-live-dot" aria-hidden="true"></span>
              <span>Live Sim Log</span>
            </div>
            <span class="s-simlog-ctx">Doctor Sim · Practo</span>
          </div>
          <div class="s-simlog-body" id="hero-simlog">
            <div class="s-logline" data-state="normal">
              <span class="s-ts">00:04</span>
              <span class="s-lt">Landed on the homepage. Looking for a search bar to find specialists.</span>
            </div>
            <div class="s-logline" data-state="normal">
              <span class="s-ts">00:09</span>
              <span class="s-lt">Found search. Typed "cardiologist Mumbai". Results are loading.</span>
            </div>
            <div class="s-logline" data-state="normal">
              <span class="s-ts">00:14</span>
              <span class="s-lt">47 results shown. Scanning for a price filter — I want to stay under ₹500.</span>
            </div>
            <div class="s-logline" data-state="confused">
              <span class="s-ts">00:21</span>
              <span class="s-lt">No price filter visible. The onboarding doc mentioned one on page 4. I can't find it.</span>
            </div>
            <div class="s-logline" data-state="confused">
              <span class="s-ts">00:27</span>
              <span class="s-lt">Clicking the first result to check fees. ₹800 — too high. Going back.</span>
            </div>
            <div class="s-logline" data-state="abandon">
              <span class="s-ts">00:51</span>
              <span class="s-lt">I've been looking for 45 seconds. In real life I'd call my assistant. Abandoning.</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── PROBLEM ─── -->
<section class="s-section s-bg-alt" id="problem" aria-label="The problem">
  <div class="sw">
    <div class="reveal">
      <div class="s-eyebrow">The problem</div>
      <h2>Product teams are shipping blind.</h2>
      <p class="s-lead">You test if the app works. Nobody tests if real users understand it.</p>
    </div>
    <div class="s-card-grid s-grid-3 reveal">
      <div class="s-card">
        <div class="s-card-num">01</div>
        <h3>User research is too slow and expensive.</h3>
        <p>A proper usability study takes 3–6 weeks and costs lakhs. Most PMs skip it entirely and ship on gut feel.</p>
      </div>
      <div class="s-card">
        <div class="s-card-num">02</div>
        <h3>QA tools test if the app works — not if users understand it.</h3>
        <p>Playwright and Cypress confirm buttons work. They can't tell you if a 52-year-old doctor would trust the UI or find the booking flow.</p>
      </div>
      <div class="s-card">
        <div class="s-card-num">03</div>
        <h3>Analytics shows where users drop off — never why.</h3>
        <p>Funnels tell you 40% abandoned at step 3. They never tell you if users were confused, distrustful, or just lost.</p>
      </div>
      <div class="s-card">
        <div class="s-card-num">04</div>
        <h3>Onboarding documentation goes stale immediately.</h3>
        <p>UI elements get renamed, steps get reordered. New users follow the PDF and get lost — and nobody finds out.</p>
      </div>
      <div class="s-card s-card-span2">
        <div class="s-card-num">05</div>
        <h3>Two-sided platforms can't test both sides together.</h3>
        <p>A doctor listing availability and a patient booking it involves a handoff that single-user testing can never surface.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── HOW IT WORKS ─── -->
<section class="s-section" id="how" aria-label="How it works">
  <div class="sw">
    <div class="reveal">
      <div class="s-eyebrow">How it works</div>
      <h2>Meet your Sims.</h2>
      <p class="s-lead">Build an AI persona, give it a mission, watch it navigate your product autonomously — narrating every decision in plain English.</p>
    </div>
    <div class="s-steps reveal">
      <div class="s-step">
        <div class="s-step-num" aria-hidden="true">01</div>
        <div class="s-step-icon" aria-hidden="true">🎭</div>
        <h3>Build a Sim</h3>
        <p>Choose a role, set demographics, adjust six behavioral sliders. Presets like "Busy Senior Doctor" auto-fill a complete profile.</p>
      </div>
      <div class="s-step-arrow" aria-hidden="true">→</div>
      <div class="s-step">
        <div class="s-step-num" aria-hidden="true">02</div>
        <div class="s-step-icon" aria-hidden="true">🎯</div>
        <h3>Set a mission</h3>
        <p>A target URL, a plain-English goal, and optionally an onboarding document the Sim is constrained to use.</p>
      </div>
      <div class="s-step-arrow" aria-hidden="true">→</div>
      <div class="s-step">
        <div class="s-step-num" aria-hidden="true">03</div>
        <div class="s-step-icon" aria-hidden="true">🤖</div>
        <h3>Watch it run</h3>
        <p>The Sim navigates live. Its reasoning streams beside it — confusion, hesitation, and all — in real time.</p>
      </div>
      <div class="s-step-arrow" aria-hidden="true">→</div>
      <div class="s-step">
        <div class="s-step-num" aria-hidden="true">04</div>
        <div class="s-step-icon" aria-hidden="true">📋</div>
        <h3>Get a Sim Report</h3>
        <p>A shareable, plain-English summary of what broke and why. Forward it without explanation.</p>
      </div>
    </div>
    <!-- Split-screen live run mockup -->
    <div class="s-splitscreen reveal" aria-label="Live Sim Run example">
      <div class="s-split-label">
        <span class="s-eyebrow" style="margin-bottom:0">Live Sim Run — step 3</span>
      </div>
      <div class="s-split-panels">
        <!-- Browser panel -->
        <div class="s-split-browser">
          <div class="s-mock-bar">
            <div class="s-mock-dots"><span></span><span></span><span></span></div>
            <div class="s-mock-url">practo.com/search/cardiologist-mumbai</div>
          </div>
          <div class="s-mock-screen">
            <div class="s-mock-searchbar">🔍 cardiologist Mumbai</div>
            <div class="s-mock-results">
              <div class="s-mock-result">
                <div class="s-mock-avatar">RM</div>
                <div class="s-mock-info">
                  <div class="s-mock-name">Dr. Rajan Mehta</div>
                  <div class="s-mock-spec">Cardiologist · 15 yrs exp · Bandra</div>
                  <div class="s-mock-fee s-fee-high">₹800 / consultation</div>
                </div>
                <div class="s-mock-book">Book</div>
              </div>
              <div class="s-mock-result s-mock-result-active">
                <div class="s-mock-avatar">SP</div>
                <div class="s-mock-info">
                  <div class="s-mock-name">Dr. Sunita Pillai</div>
                  <div class="s-mock-spec">Cardiologist · 8 yrs exp · Andheri</div>
                  <div class="s-mock-fee s-fee-high">₹600 / consultation</div>
                </div>
                <div class="s-mock-book">Book</div>
              </div>
              <div class="s-mock-result">
                <div class="s-mock-avatar">AK</div>
                <div class="s-mock-info">
                  <div class="s-mock-name">Dr. Arjun Kumar</div>
                  <div class="s-mock-spec">Cardiologist · 22 yrs exp · Juhu</div>
                  <div class="s-mock-fee s-fee-high">₹1,200 / consultation</div>
                </div>
                <div class="s-mock-book">Book</div>
              </div>
            </div>
            <div class="s-mock-no-filter">
              <span>No fee filter found on this page</span>
            </div>
            <div class="s-cursor-trail">
              <div class="s-cursor"></div>
            </div>
          </div>
        </div>
        <!-- Live log panel -->
        <div class="s-split-log">
          <div class="s-simlog-bar">
            <div class="s-simlog-live">
              <span class="s-live-dot" aria-hidden="true"></span>
              <span>Live Sim Log</span>
            </div>
            <span class="s-simlog-ctx">Dr. Arjun Mehta · 52 · Pune</span>
          </div>
          <div class="s-simlog-body">
            <div class="s-logline" data-state="normal">
              <span class="s-ts">00:04</span>
              <span class="s-lt">Landed on homepage. Looking for a search bar.</span>
            </div>
            <div class="s-logline" data-state="normal">
              <span class="s-ts">00:09</span>
              <span class="s-lt">Typed "cardiologist Mumbai". 47 results.</span>
            </div>
            <div class="s-logline" data-state="confused">
              <span class="s-ts">00:21</span>
              <span class="s-lt">No price filter visible. The PDF mentioned one on page 4. I can't find it.</span>
            </div>
            <div class="s-logline" data-state="confused">
              <span class="s-ts">00:27</span>
              <span class="s-lt">Clicking results one by one to check fees. ₹800 — too high. Back again.</span>
            </div>
            <div class="s-logline" data-state="abandon">
              <span class="s-ts">00:51</span>
              <span class="s-lt">45 seconds in. I'd call my assistant in real life. Abandoning.</span>
            </div>
          </div>
          <div class="s-split-score">
            <div class="s-score-row">
              <span class="s-score-label">Task completion</span>
              <span class="s-score-val s-score-low">3/10</span>
            </div>
            <div class="s-score-row">
              <span class="s-score-label">Confusion score</span>
              <span class="s-score-val s-score-warn">62/100</span>
            </div>
            <div class="s-score-row">
              <span class="s-score-label">Result</span>
              <span class="s-score-badge">Abandoned</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Full Sim Log -->
    <div class="s-simlog s-simlog-full reveal" aria-label="Full Sim Log sample">
      <div class="s-simlog-bar">
        <div class="s-simlog-live">
          <span class="s-live-dot" aria-hidden="true"></span>
          <span>Live Sim Log</span>
        </div>
        <span class="s-simlog-ctx">Dr. Arjun Mehta, 52 · Pune · Mission: "Book a cardiologist under ₹500"</span>
      </div>
      <div class="s-simlog-body">
        <div class="s-logline" data-state="normal">
          <span class="s-ts">00:04</span>
          <span class="s-lt">Landed on the homepage. Looking for a search bar to find specialists.</span>
        </div>
        <div class="s-logline" data-state="normal">
          <span class="s-ts">00:09</span>
          <span class="s-lt">Found search. Typed "cardiologist Mumbai". Results are loading.</span>
        </div>
        <div class="s-logline" data-state="normal">
          <span class="s-ts">00:14</span>
          <span class="s-lt">47 results shown. Scanning for a price filter — I want to stay under ₹500.</span>
        </div>
        <div class="s-logline" data-state="confused">
          <span class="s-ts">00:21</span>
          <span class="s-lt">No price filter visible. The onboarding doc mentioned one on page 4. I can't find it.</span>
        </div>
        <div class="s-logline" data-state="confused">
          <span class="s-ts">00:27</span>
          <span class="s-lt">Clicking the first result manually to check fees. ₹800 — too high. Going back.</span>
        </div>
        <div class="s-logline" data-state="normal">
          <span class="s-ts">00:33</span>
          <span class="s-lt">Trying the second result. ₹600. Still over my budget. Back again.</span>
        </div>
        <div class="s-logline" data-state="confused">
          <span class="s-ts">00:41</span>
          <span class="s-lt">There are 47 results and I have to check each one manually? This is ridiculous.</span>
        </div>
        <div class="s-logline" data-state="abandon">
          <span class="s-ts">00:51</span>
          <span class="s-lt">I've been looking for 45 seconds. In real life I'd call my assistant. Abandoning.</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── FEATURES ─── -->
<section class="s-section s-bg-alt" id="features" aria-label="Features">
  <div class="sw">
    <div class="reveal">
      <div class="s-eyebrow">Features</div>
      <h2>Everything you need to test like a real user.</h2>
      <p class="s-lead">From persona building to doc gap detection — the full stack for behavioural UX testing.</p>
    </div>
    <!-- Hero feature: Doc Gap Testing -->
    <div class="s-feat-hero reveal">
      <div class="s-feat-hero-badge">The feature no competitor has</div>
      <div class="s-feat-hero-body">
        <div class="s-feat-hero-text">
          <div class="s-feat-hero-icon" aria-hidden="true">📄</div>
          <h3>Documentation gap testing</h3>
          <p>Load your onboarding PDF and constrain the Sim to use only that document's knowledge. It surfaces every mismatch between what your docs promise and what your product actually does.</p>
          <ul class="s-feat-list">
            <li>Renamed buttons your docs haven't caught up to</li>
            <li>Moved elements and missing prerequisite steps</li>
            <li>Stale screenshots and removed features</li>
            <li>Every gap, flagged automatically — no full Sim run required</li>
          </ul>
        </div>
        <div class="s-feat-hero-visual" aria-label="Documentation diff example">
          <div class="s-docdiff">
            <div class="s-docdiff-bar">
              <span>📄 onboarding-guide-v2.pdf</span>
              <span class="s-docdiff-tag">vs live product</span>
            </div>
            <div class="s-dditem s-dd-warn">
              <span class="s-dd-icon" aria-hidden="true">⚠</span>
              <div>
                <div class="s-dd-label">Button renamed</div>
                <div class="s-dd-detail">PDF says "Book Appointment" → UI says "Schedule Visit"</div>
              </div>
            </div>
            <div class="s-dditem s-dd-warn">
              <span class="s-dd-icon" aria-hidden="true">⚠</span>
              <div>
                <div class="s-dd-label">Step missing</div>
                <div class="s-dd-detail">PDF skips the "Verify mobile" step added in v4.2</div>
              </div>
            </div>
            <div class="s-dditem s-dd-error">
              <span class="s-dd-icon" aria-hidden="true">✕</span>
              <div>
                <div class="s-dd-label">Feature removed</div>
                <div class="s-dd-detail">PDF references "Fee Filter" — removed in last sprint</div>
              </div>
            </div>
            <div class="s-dditem s-dd-ok">
              <span class="s-dd-icon" aria-hidden="true">✓</span>
              <div>
                <div class="s-dd-label">Matches</div>
                <div class="s-dd-detail">Search flow matches PDF steps 1–3</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Feature grid -->
    <div class="s-card-grid s-grid-4 reveal">
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">🧬</div>
        <h3>Sim DNA builder</h3>
        <p>Role selector, demographic inputs, and six behavioral sliders: Tech Comfort, Reading Patience, Goal Urgency, Trust in UI, Risk Tolerance, and Irrationality Factor.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">🔴</div>
        <h3>Live Sim run</h3>
        <p>Split screen: the Sim navigating on the left, real-time reasoning on the right. Cursor trails, click-pulse animations, confusion zones highlighted as they happen.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">📊</div>
        <h3>Sim report</h3>
        <p>A shareable, plain-English output built for PMs. Mission result, success rate, confusion points, click heatmap, and recommended fixes.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">👥</div>
        <h3>Persona comparison</h3>
        <p>Run the same mission across multiple Sim types at once. See how a Doctor Sim, a Patient Sim, and a First-timer each succeed or fail on the same flow.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">📈</div>
        <h3>UX confusion score</h3>
        <p>A single trackable metric per session. "Doctor Sim score went from 62 to 78 after the navigation redesign." Watch it move across releases.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">🔥</div>
        <h3>Click heatmap</h3>
        <p>Click coordinates logged per session, rendered as a heatmap overlay on a page screenshot. See exactly where each persona got stuck.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">⚡</div>
        <h3>Stale content detector</h3>
        <p>A fast scan that cross-references every UI reference in your docs against the live product — no full Sim run required.</p>
      </div>
      <div class="s-card s-card-accent">
        <div class="s-card-badge">Phase 3</div>
        <div class="s-card-icon" aria-hidden="true">🧠</div>
        <h3>Sim Imprint</h3>
        <p>A 15-minute session where a real user trains a Sim on their actual behavior — producing an empirical behavioral fingerprint, not an estimated baseline.</p>
      </div>
    </div>
  </div>
</section>

<!-- ─── TECHNOLOGY ─── -->
<section class="s-section s-tech-strip" id="technology" aria-label="Technology">
  <div class="sw">
    <div class="s-tech-inner reveal">
      <div class="s-eyebrow">Under the hood</div>
      <h2>Built on large language models and real browser automation.</h2>
      <p class="s-lead">Simulr doesn't simulate clicks in a sandbox. It drives a real browser — reading the live DOM, navigating like a person would, and reasoning through every decision using large language models. The result is behaviour you can trust, not a scripted path.</p>
      <div class="s-tech-grid">
        <div class="s-tech-item">
          <div class="s-tech-icon">🧠</div>
          <div>
            <div class="s-tech-name">Large Language Models</div>
            <div class="s-tech-desc">Power persona reasoning, decision-making, and natural-language report generation.</div>
          </div>
        </div>
        <div class="s-tech-item">
          <div class="s-tech-icon">🌐</div>
          <div>
            <div class="s-tech-name">Live Browser Automation</div>
            <div class="s-tech-desc">Each Sim navigates a real browser — no sandbox, no mocked DOM, no scripted paths.</div>
          </div>
        </div>
        <div class="s-tech-item">
          <div class="s-tech-icon">📄</div>
          <div>
            <div class="s-tech-name">Document Intelligence</div>
            <div class="s-tech-desc">Parses your onboarding PDFs and cross-references every claim against the live product.</div>
          </div>
        </div>
        <div class="s-tech-item">
          <div class="s-tech-icon">⚡</div>
          <div>
            <div class="s-tech-name">Real-Time Streaming</div>
            <div class="s-tech-desc">Persona reasoning streams live as the Sim navigates — no waiting for a final report.</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ─── USE CASES ─── -->
<section class="s-section s-bg-alt" id="usecases" aria-label="Who Simulr is for">
  <div class="sw">
    <div class="reveal">
      <div class="s-eyebrow">Use cases</div>
      <h2>Who Simulr is for.</h2>
    </div>
    <div class="s-card-grid s-grid-3 reveal">
      <div class="s-card s-card-primary">
        <div class="s-card-icon" aria-hidden="true">🎯</div>
        <h3>Product managers</h3>
        <p>Find real UX problems in hours, not weeks. No recruiting, no waiting on analytics. Forward a Sim Report into your next sprint planning without explanation.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">🤝</div>
        <h3>Customer success &amp; sales</h3>
        <p>Audit onboarding PDFs before the next enterprise client goes live. Catch every doc gap before your CSM discovers it on a call.</p>
      </div>
      <div class="s-card">
        <div class="s-card-icon" aria-hidden="true">🔁</div>
        <h3>Two-sided &amp; marketplace platforms</h3>
        <p>Test both sides of a marketplace together — a seller and a buyer, a host and a guest, a provider and a customer. Surface handoff failures no single-user test ever catches.</p>
      </div>
    </div>
    <div class="s-missions reveal">
      <div class="s-missions-label">Example missions</div>
