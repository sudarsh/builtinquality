<script>
// ─── Nav: transparent → solid on scroll ───
(function () {
  const nav = document.getElementById('snav');
  if (!nav) return;
  const onScroll = () => {
    nav.classList.toggle('snav-solid', window.scrollY > 20);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();

// ─── Hamburger menu ───
(function () {
  const btn = document.getElementById('snav-burger');
  const menu = document.getElementById('snav-mobile');
  if (!btn || !menu) return;
  btn.addEventListener('click', () => {
    const open = menu.hidden === false;
    menu.hidden = open;
    btn.setAttribute('aria-expanded', String(!open));
  });
  // close on link click
  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); });
  });
})();

// ─── Scroll reveal ───
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const els = document.querySelectorAll('#simulr-page .reveal');
  if (!els.length) return;
  const io = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('revealed'); io.unobserve(e.target); }
    });
  }, { threshold: 0.08 });
  els.forEach(el => io.observe(el));
})();

// ─── Sim Log: type-in animation ───
(function () {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  const logs = document.querySelectorAll('#simulr-page .s-simlog-body');
  logs.forEach(log => {
    const lines = Array.from(log.querySelectorAll('.s-logline'));
    lines.forEach(l => { l.style.opacity = '0'; l.style.transform = 'translateY(6px)'; l.style.transition = 'opacity 0.3s ease, transform 0.3s ease'; });
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (!e.isIntersecting) return;
        lines.forEach((line, i) => {
          setTimeout(() => {
            line.style.opacity = '1'; line.style.transform = 'none';
          }, i * 180);
        });
        io.unobserve(e.target);
      });
    }, { threshold: 0.2 });
    io.observe(log);
  });
})();
</script>
